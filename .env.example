# Copy to .env and adjust values for local development.
# Do not commit .env to version control.

DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: Redis for WebSocket channel layer (recommended for production)
# Leave empty to use in-memory channel layer locally.
REDIS_URL=
